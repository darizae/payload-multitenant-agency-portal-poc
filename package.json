{
  "name": "payload-multitenant-agency-portal-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PAYLOAD_PUSH_SCHEMA=false next dev --webpack",
    "build": "PAYLOAD_PUSH_SCHEMA=false next build --webpack",
    "start": "PAYLOAD_PUSH_SCHEMA=false next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "db:up": "docker compose up -d postgres adminer",
    "db:down": "docker compose down --remove-orphans",
    "db:reset": "docker compose down -v --remove-orphans && docker compose up -d postgres adminer",
    "db:logs": "docker compose logs -f postgres adminer",
    "db:status": "docker compose ps",
    "db:poll": "node scripts/db-poll.mjs",
    "db:reseed": "npm run db:reset && npm run db:poll && npm run seed",
    "data:generate": "python3 scripts/data/generate_shopify_metrics_parquet.py",
    "seed": "PAYLOAD_PUSH_SCHEMA=true node --env-file=.env --import tsx scripts/seed.ts",
    "bootstrap": "npm run db:reset && npm run db:poll && npm run generate:types && npm run generate:importmap && npm run seed",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/material-nextjs": "^7.3.9",
    "@payloadcms/db-postgres": "3.80.0",
    "@payloadcms/next": "3.80.0",
    "graphql": "^16.13.1",
    "next": "^16.2.0",
    "parquetjs-lite": "^0.8.7",
    "payload": "3.80.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.34.5",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "overrides": {
    "ajv": "8.18.0",
    "dompurify": "3.3.2",
    "esbuild": "0.25.11",
    "file-type": "21.3.4"
  }
}
